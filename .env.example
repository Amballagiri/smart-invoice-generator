SECRET_KEY=replace-with-a-long-random-value
# AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_MODEL=gpt-5
# To use OpenRouter instead, set AI_PROVIDER=openrouter and add your key locally.
# OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
# DATABASE_URL=sqlite:///instance/smart_invoice.db
# Google OAuth (Google Cloud Console -> OAuth 2.0 Client ID)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# Optional. When unset, the callback is derived from the request host.
# GOOGLE_REDIRECT_URI=https://smart-invoice-generator-9k3v.onrender.com/auth/google/callback
COMPANY_NAME=Smart Invoice Generator
COMPANY_ADDRESS=123 Business Avenue, Bengaluru, Karnataka 560001
COMPANY_GST_NUMBER=29ABCDE1234F1Z5
# Optional company contact details shown on the Company/Settings page.
# COMPANY_EMAIL=you@company.com
# COMPANY_PHONE=+91 98765 43210

# Payment Configuration
UPI_ID=your-upi-id@paytm
BASE_URL=http://localhost:5000

# Payment provider: "mock" (default, no network) or "razorpay".
PAYMENT_PROVIDER=mock
# Razorpay credentials (server-side only). Leave blank when using the mock
# provider. Use rzp_test_* keys for testing and rzp_live_* keys for production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
